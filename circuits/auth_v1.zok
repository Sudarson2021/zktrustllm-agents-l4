// auth_v1 relation-aware v0
// Purpose: keep the fixed interface while upgrading the circuit from a pure
// placeholder into a first semantically meaningful relation skeleton.

def main(
    field agentKey,
    field capabilityId,
    field policyClassHash,
    field contextHash,
    field traceCommitment,
    field actionHash,
    field expiryBucket,
    private field scopeHash,
    private field capabilitySalt,
    private field actionCode,
    private field domainSepCapability,
    private field domainSepAction
) {
    // Core public bindings must exist
    assert(agentKey > 0);
    assert(capabilityId > 0);
    assert(policyClassHash > 0);
    assert(contextHash > 0);
    assert(traceCommitment > 0);
    assert(actionHash > 0);
    assert(expiryBucket > 0);

    // Core witness bindings must exist
    assert(scopeHash > 0);
    assert(domainSepCapability > 0);
    assert(domainSepAction > 0);

    // Bounded mitigation set
    // 1=keep, 2=rekey, 3=rotate, 4=isolate, 5=quarantine
    assert(actionCode > 0);
    assert(actionCode < 6);

    // Relation-aware v0 consistency constraints
    assert(agentKey != capabilityId);
    assert(agentKey != policyClassHash);
    assert(policyClassHash != actionHash);
    assert(contextHash != traceCommitment);

    // Domain separators must remain distinct
    assert(domainSepCapability != domainSepAction);

    // Scope must be distinct from the domain separators
    assert(scopeHash != domainSepCapability);
    assert(scopeHash != domainSepAction);

    // Expiry bucket must dominate the bounded action code
    assert(expiryBucket > actionCode);

    // Weak v0 anchor for capabilitySalt so it participates in the relation
    field saltAnchor = capabilitySalt + expiryBucket;
    assert(saltAnchor != 0);

    return;
}
