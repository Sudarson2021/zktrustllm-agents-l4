          "jsCode": "const source = $json;\nconst actionClass =\n  source.action_class ??\n  source.enforced_action_class ??\n  source.policy?.enforced_action_class ??\n  null;\n\nconst finalDecision =\n  source.final_decision ??\n  source.decision ??\n  source.reflection?.final_decision ??\n  null;\n\nreturn [{\n  json: {\n    demo_status: 'COMPLETED',\n    run_id: source.run_id ?? null,\n    final_decision: finalDecision,\n    enforced_action_class: actionClass,\n    governed_route: source.route ?? source.status ?? null,\n    automatic_execution_enabled:\n      source.automatic_execution_enabled ?? false,\n    production_oran_execution: false,\n    report_hash: source.report_hash ?? source.source_report_hash ?? null,\n    record_hash: source.record_hash ?? null,\n    oracle_relative: true,\n    expert_verified: false,\n    publication_ready: false,\n    scientific_boundary:\n      'One live supervisor demonstration; the paper result remains the frozen 180-cell synthetic-policy-oracle benchmark.'\n  }\n}];"
