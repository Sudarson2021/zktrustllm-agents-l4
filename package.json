{
  "name": "zktrustllm-phase1",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "ganache": "ganache -d -p 8545",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "demo": "hardhat run scripts/demo.js --network localhost",
    "gen:mmlu": "MODEL=${MODEL:-gpt-5} DATA=data/mmlu_dev.jsonl OUT=outputs_openai/mmlu_answers.jsonl node scripts/gen_answers_openai.mjs",
    "score:mmlu": "node scripts/score_mcq.js --file outputs_openai/mmlu_answers.jsonl",
    "evidence:mmlu": "node -e \"const fs=require('fs'); fs.writeFileSync('outputs_openai/evidence_openai.json', JSON.stringify({model:(process.env.MODEL||'gpt-5'),dataset:'data/mmlu_dev.jsonl',answers:'outputs_openai/mmlu_answers.jsonl',metric:'accuracy',protocol:'MCQ letter-only',timestamp:new Date().toISOString()},null,2))\"",
    "ipfs:mmlu": "ipfs add -q outputs_openai/evidence_openai.json",
    "phase5:submit": "RATING=${RATING:-80} WEIGHT=100 EVIDENCE=outputs_openai/evidence_openai.json npx hardhat run scripts/zk_submit_with_evidence.js --network localhost",
    "phase5:report": "npx hardhat run scripts/report.js --network localhost",
    "bench:run": "node scripts/bench_many.mjs > outputs_openai/bench.ndjson",
    "bench:csv": "node scripts/bench_to_csv.mjs outputs_openai/bench.ndjson outputs_openai/bench.csv",
    "bench:md": "node scripts/report_markdown.mjs outputs_openai/bench.ndjson outputs_openai/bench_report.md",
    "pipeline": "bash scripts/run_pipeline.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "This project demonstrates a basic Hardhat use case. It comes with a sample contract, a test for that contract, and a Hardhat Ignition module that deploys that contract.",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@nomicfoundation/solidity-analyzer-linux-x64-gnu": "^0.1.2",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "ganache": "^7.9.2",
    "hardhat": "^2.26.3",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "openai": "^6.1.0",
    "p-limit": "^7.1.1"
  },
  "directories": {
    "test": "test"
  }
}
