{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentMessage",
  "type": "object",
  "required": [
    "senderAgentId",
    "receiverAgentId",
    "taskId",
    "capabilityId",
    "contextHash",
    "payloadHash",
    "policyClass",
    "timestamp",
    "signature"
  ],
  "properties": {
    "senderAgentId": { "type": "string" },
    "receiverAgentId": { "type": "string" },
    "taskId": { "type": "string" },
    "capabilityId": { "type": "string" },
    "contextHash": { "type": "string" },
    "payloadHash": { "type": "string" },
    "policyClass": { "type": "string" },
    "timestamp": { "type": "integer" },
    "signature": { "type": "string" }
  }
}
